# Copy these names into your hosting provider's protected Variables UI.
# Do not commit real values. Paper mode requires no Lighter exchange private key.
DATABASE_URL=
OPENROUTER_API_KEY=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_ALLOWED_ORIGINS=
PORT=3000

TRADING_MODE=paper
TRADING_ENABLED=false
TRADING_INTERVAL_MS=3600000
MAX_POSITION_NOTIONAL_USD=100
MAX_ORDER_QUANTITY=1
MAX_ORDER_SLIPPAGE_FRACTION=0.01
PAPER_INITIAL_BALANCE_USD=1000
PAPER_TRADING_FEE_RATE=0.0005
PORTFOLIO_TRACK_INTERVAL_MS=120000

# Leave unset in paper mode. Required only for future credential encryption work.
CREDENTIAL_ENCRYPTION_KEY=
# Leave these unset; live trading is not approved.
LIVE_TRADING_ACK=
VITE_BACKEND_URL=
